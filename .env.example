# ============================================================
# EVM Swiss Army Knife — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# --- Telegram Bot (Required) ---
# Get your token from https://t.me/BotFather (/newbot)
# Optional: enable inline queries via /setinline in @BotFather
BOT_TOKEN=your-telegram-bot-token-here

# --- EVM RPC Endpoints ---
# Public defaults work out of the box; replace with Alchemy/Infura/QuickNode for higher rate limits
RPC_URL_ETH=https://ethereum-rpc.publicnode.com
RPC_URL_ETH_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_BASE=https://base-rpc.publicnode.com
RPC_URL_BASE_SEPOLIA=https://base-sepolia-rpc.publicnode.com

# --- Block Explorer API (Optional, needed for /source) ---
# Unified Etherscan API V2 key: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# --- Google Gemini AI (Optional, needed for /ask, /ai, /audit) ---
# Free API key available at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Signature Databases (Public, no API key needed) ---
OPENCHAIN_API_URL=https://api.openchain.xyz/signature-database/v1/lookup
FOURBYTE_API_URL=https://www.4byte.directory/api/v1/signatures/

# --- Disassembler Settings ---
MAX_DISASM_LINES=80
